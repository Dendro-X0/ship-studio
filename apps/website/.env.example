# Paddle overlay (Studio Solo) + Polar unused + download
# https://developer.paddle.com/build/checkout/build-overlay-checkout
# Sandbox first. Do not commit tokens.

PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_PRICE_ID=
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_PRICE_LABEL=$29
# Optional: Paddle customer portal URL (not vendors.paddle.com)
PUBLIC_PADDLE_PORTAL_URL=
PUBLIC_REFUND_WINDOW_DAYS=14
PUBLIC_SUPPORT_EMAIL=
PUBLIC_DOWNLOAD_URL=https://github.com/Dendro-X0/ship-studio/releases/tag/v0.2.3
