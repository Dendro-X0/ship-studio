# Optional Solo Buy overlay on /pricing (this site only).
# Operator: Paddle dashboard → fill these → Put on host → Redeploy.
# See apps/website/docs/PADDLE-SETUP.md
# Sandbox first. Do not commit tokens. Never put pdl_… API keys here.

PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_PRICE_ID=
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_PRICE_LABEL=$29
# Optional: Paddle customer portal URL (not vendors.paddle.com)
PUBLIC_PADDLE_PORTAL_URL=
PUBLIC_REFUND_WINDOW_DAYS=14
PUBLIC_SUPPORT_EMAIL=
PUBLIC_DOWNLOAD_URL=https://github.com/Dendro-X0/ship-studio/releases/tag/v0.2.5
