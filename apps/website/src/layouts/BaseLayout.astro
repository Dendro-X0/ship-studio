---
import "../styles/global.css";
import { downloadUrl } from "../lib/commerce";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = "Local shipping hub for the final mile — sign, release, deploy.",
  path = "/",
} = Astro.props;

const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,450;9..144,550&family=IBM+Plex+Mono:wght@400;500&family=Sora:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-nav" id="site-nav">
        <a class="brand" href="/">
          <img class="brand-mark" src="/favicon-32.png" width="22" height="22" alt="" />
          Orbit Yard
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/intent" aria-current={path === "/intent" ? "page" : undefined}>Intent</a>
          <a href="/honesty" aria-current={path === "/honesty" ? "page" : undefined}>Honesty</a>
          <a href="/faq" aria-current={path === "/faq" ? "page" : undefined}>FAQ</a>
          <a href="/docs" aria-current={path.startsWith("/docs") ? "page" : undefined}>Docs</a>
          <a href="/demo" aria-current={path === "/demo" ? "page" : undefined}>Demo</a>
          <a href="/pricing" aria-current={path === "/pricing" ? "page" : undefined}>Get it</a>
          <a
            class="btn btn-primary"
            href={downloadUrl()}
            rel="noopener noreferrer"
          >Download</a>
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Orbit Yard · local shipping hub</span>
        <nav aria-label="Legal">
          <a href="/license">License</a>
          <a href="/faq">FAQ</a>
          <a href="/pricing">Get it</a>
          <a href="/legal/terms">Terms</a>
          <a href="/legal/privacy">Privacy</a>
          <a href="https://github.com/Dendro-X0/ship-studio">GitHub</a>
        </nav>
      </footer>
    </div>
    <script>
      const nav = document.getElementById("site-nav");
      const onScroll = () => {
        if (!nav) return;
        nav.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
