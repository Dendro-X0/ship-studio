---
import BaseLayout from "../layouts/BaseLayout.astro";
import { checkoutConfigured, downloadUrl } from "../lib/commerce";

const buyHref = "/pricing";
const buyLabel = checkoutConfigured() ? "Buy Solo" : "See pricing";
---

<BaseLayout
  title="Orbit Yard — first public URL, honest gates"
  description="Get your first public host URL live from your PC — visible process, visible result, honest gates. Not the agentic ship.studio product."
  path="/"
>
  <section class="hero" aria-label="Hero">
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="hero-brand">Orbit Yard</p>
      <h1 class="hero-line">First public URL — honest gates.</h1>
      <p class="hero-support">
        Done when your site is live (or the named gate says so). Open the host, deploy from this
        PC, Confirm — Studio does not replace Cloudflare, Apple, or Polar. Download is the full
        OSS tool — try everything; no timed trial wall.
        <a href="/intent">What this is for</a>.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={downloadUrl()}>Download</a>
        <a class="btn" href="/demo">Demo</a>
        <a class="btn" href="/docs">Docs</a>
        <a class="btn" href={buyHref}>{buyLabel}</a>
      </div>
    </div>
  </section>

  <section class="section home-band" aria-label="Surfaces">
    <h2>Three surfaces. One outcome.</h2>
    <p class="lead">
      <code>orbityard</code> is the kernel. CLI, TUI, and Desktop share the same path to a
      <strong>public URL</strong> (or a named Confirm gate). Detail panels never become a second wizard.
    </p>
    <div class="home-grid">
      <article>
        <h3>CLI</h3>
        <p>JSON and MCP for agents. Humans still hold keys.</p>
      </article>
      <article>
        <h3>TUI</h3>
        <p>Terminal client for the same plan and Confirm gates.</p>
      </article>
      <article>
        <h3>Desktop</h3>
        <p>Publish spine and Deployment for one live URL. Integrations stay optional deep links.</p>
      </article>
    </div>
  </section>

  <section class="section home-band" aria-label="Payments honesty">
    <h2>Payments: two different jobs.</h2>
    <div class="home-split">
      <article>
        <h3>Your product</h3>
        <p>
          Soft no: Integrations is an optional <strong>guide</strong>, not required to ship —
          Polar, Stripe, Gumroad, Lemon Squeezy,
          <a href="https://www.paddle.com/">Paddle</a>,
          <a href="https://www.creem.io/">Creem</a>, and
          <a href="https://www.waffo.ai/">Waffo</a>. Open the vendor, put
          <code>PUBLIC_*</code> / host secrets <strong>outside</strong> Studio, then Confirm the
          listing step. Studio never creates SKUs or holds API keys.
        </p>
      </article>
      <article>
        <h3>This site</h3>
        <p>
          Orbit Yard Solo checkout is <strong>Paddle</strong> overlay when
          <code>PUBLIC_PADDLE_*</code> is set on the site host. Creem and Waffo stay Integrations
          <strong>guides</strong> for your products — not ways to buy this license. Until env is
          set, <a href={downloadUrl()}>download OSS builds</a> or <a href="/pricing">see pricing</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
