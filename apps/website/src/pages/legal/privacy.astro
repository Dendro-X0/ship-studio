---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy — Orbit Yard"
  description="Privacy practices for the Orbit Yard website."
  path="/legal/privacy"
>
  <section class="section legal">
    <h1>Privacy</h1>
    <p class="lead">
      The desktop and CLI tools are offline-first. This website is documentation and free download
      links. There is <strong>no public paid checkout</strong> on this site.
    </p>
    <p>
      The apps do not store secret values in <code>.ship/</code>. This website may use standard
      hosting logs. We do not collect card numbers.
    </p>
    <p>
      Source and issues live on GitHub. Do not send API keys or tokens to the project maintainers
      or into git.
    </p>
  </section>
</BaseLayout>
