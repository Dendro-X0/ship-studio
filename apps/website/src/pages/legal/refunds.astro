---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { refundWindowDays, supportEmail } from "../../lib/commerce";

const days = refundWindowDays();
const email = supportEmail();
---

<BaseLayout
  title="Refunds — Orbit Yard"
  description={`${days}-day refund window via Paddle. Money-back only — Studio is a local tool.`}
  path="/legal/refunds"
>
  <section class="section legal">
    <h1>Refunds</h1>
    <p class="lead">
      If Orbit Yard is not right for you, request a refund within
      <strong>{days} days</strong> of purchase. All card processing stays on Paddle.
    </p>

    <h2>How to request</h2>
    <ol>
      <li>
        Email
        {
          email ? (
            <a href={`mailto:${email}?subject=Ship%20Studio%20refund`}> {email} </a>
          ) : (
            <span> the maintainer </span>
          )
        }
        with your Paddle transaction ID (from the Paddle receipt email).
      </li>
      <li>
        In-window refunds are processed on Paddle — we never hold your card. You get the money back
        through Paddle, not through this website.
      </li>
    </ol>

    <h2>What a refund means</h2>
    <p>
      Orbit Yard runs on your machine. A refund returns your payment. It does <strong>not</strong>
      remotely uninstall binaries, wipe projects, or delete your local
      <a href="/license">license file</a>. Stop using the software if you refund — the maintainer
      marks the order revoked in the local ledger after Paddle pays you back.
    </p>

    <h2>Non-refundable</h2>
    <ul>
      <li>Requests after the {days}-day window (unless required by applicable law)</li>
      <li>Chargebacks filed after a completed Paddle refund</li>
      <li>Purchases explicitly marked non-refundable (none on the Solo plan today)</li>
    </ul>
  </section>
</BaseLayout>
