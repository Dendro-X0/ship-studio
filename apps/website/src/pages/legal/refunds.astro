---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supportEmail } from "../../lib/commerce";

const email = supportEmail();
---

<BaseLayout
  title="Refunds — Orbit Yard"
  description="Orbit Yard is not sold. No new refunds — legacy Solo purchases only."
  path="/legal/refunds"
>
  <section class="section legal">
    <h1>Refunds</h1>
    <p class="lead">
      Orbit Yard is <strong>not for sale</strong>. There is no active checkout and no new refund
      window.
    </p>

    <h2>Legacy Solo purchases</h2>
    <p>
      If you paid for the cancelled Solo experiment via Paddle and still need a refund question
      answered, email
      {
        email ? (
          <a href={`mailto:${email}?subject=Orbit%20Yard%20legacy%20refund`}>{email}</a>
        ) : (
          <span>the maintainer</span>
        )
      }
      with your Paddle transaction ID. New purchases are not offered — prefer
      <a href="/pricing">free Download</a>.
    </p>
  </section>
</BaseLayout>
