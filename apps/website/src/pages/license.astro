---
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloadUrl, supportEmail } from "../lib/commerce";

const email = supportEmail();
---

<BaseLayout
  title="License — Orbit Yard"
  description="Orbit Yard is MIT open source. No Solo purchase required."
  path="/license"
>
  <section class="section">
    <h1>License</h1>
    <p class="lead">
      Orbit Yard is <strong>MIT-licensed</strong> open source. You do not need to buy a Solo key
      file to download, build, or run the tool.
    </p>

    <h2>How to get it</h2>
    <ol class="list-clean license-steps">
      <li>
        <a href={downloadUrl()} rel="noopener noreferrer">Download</a> a GitHub Release, or clone
        <a href="https://github.com/Dendro-X0/ship-studio">the repo</a>.
      </li>
      <li>Open <a href="/docs/start">Start here</a> and bind a project.</li>
      <li>Ship a live URL via Publish / Deployment — Confirm when the gate is true.</li>
    </ol>

    <div class="hero-cta" style="margin-top: 1.5rem">
      <a class="btn btn-primary" href={downloadUrl()} rel="noopener noreferrer">Download</a>
      <a
        class="btn"
        href="https://github.com/Dendro-X0/ship-studio/blob/main/LICENSE"
        rel="noopener noreferrer"
        >MIT License</a
      >
      <a class="btn" href="/pricing">Get it free</a>
    </div>

    <p class="price-meta" style="margin-top: 1.5rem">
      Historical note: a local <code>orbit-yard.license</code> file existed for the cancelled Solo
      experiment. It is not required for current builds.
      {
        email ? (
          <>
            {" "}
            Questions: <a href={`mailto:${email}`}>{email}</a>.
          </>
        ) : null
      }
    </p>
  </section>
</BaseLayout>
