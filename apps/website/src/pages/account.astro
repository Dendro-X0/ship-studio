---
import BaseLayout from "../layouts/BaseLayout.astro";
import { polarPortalUrl, supportEmail } from "../lib/commerce";

const email = supportEmail();
---

<BaseLayout
  title="Account — Ship Studio"
  description="Manage your Ship Studio order on Polar."
  path="/account"
>
  <section class="section">
    <h1>Account</h1>
    <p class="lead">
      Billing, invoices, and refunds are handled on Polar. We do not run a separate login for the
      local app.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={polarPortalUrl()} rel="noopener noreferrer" target="_blank">
        Open Polar portal
      </a>
      <a class="btn" href="/license">License file</a>
      <a class="btn" href="/legal/refunds">Refund policy</a>
      <a class="btn" href="/docs/start">Docs</a>
    </div>
    {
      email ? (
        <p class="price-meta" style="margin-top: 1.5rem">
          Support / license resend: <a href={`mailto:${email}`}>{email}</a>
        </p>
      ) : null
    }
  </section>
</BaseLayout>
