---
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloadUrl, supportEmail } from "../lib/commerce";

const email = supportEmail();
---

<BaseLayout
  title="Account — Orbit Yard"
  description="Orbit Yard is not sold. No customer billing account."
  path="/account"
>
  <section class="section">
    <h1>Account</h1>
    <p class="lead">
      There is no paid Orbit Yard product and no customer portal. Download the OSS build — no
      account required.
    </p>
    <p>
      If you bought a Solo license in the past (cancelled commercial experiment), keep any Paddle
      receipt email you still have. New purchases are not offered.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={downloadUrl()} rel="noopener noreferrer">Download</a>
      <a class="btn" href="/pricing">Get it free</a>
      <a class="btn" href="/docs/start">Docs</a>
    </div>
    {
      email ? (
        <p class="price-meta" style="margin-top: 1.5rem">
          Questions: <a href={`mailto:${email}`}>{email}</a>
        </p>
      ) : null
    }
  </section>
</BaseLayout>
