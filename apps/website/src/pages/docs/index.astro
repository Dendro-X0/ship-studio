---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOC_PAGES } from "../../lib/docs";
---

<BaseLayout
  title="Docs — Ship Studio"
  description="Install, scope of service, Publish spine, and human gates."
  path="/docs"
>
  <section class="section">
    <h1>Documentation</h1>
    <p class="lead">
      Canonical prose from the repo — rendered here so you can read without opening GitHub.
    </p>
    <div class="doc-grid">
      {
        DOC_PAGES.map((page) => (
          <a href={`/docs/${page.slug}`}>
            <strong>{page.title}</strong>
            <span>{page.description}</span>
          </a>
        ))
      }
      <a href="/demo">
        <strong>Feature demo</strong>
        <span>Silent walk of Desktop Publish</span>
      </a>
    </div>
  </section>
</BaseLayout>
