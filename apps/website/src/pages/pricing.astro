---
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloadUrl } from "../lib/commerce";
---

<BaseLayout
  title="Get Orbit Yard — free OSS"
  description="Orbit Yard is not sold. Download free builds from GitHub Releases or build from source."
  path="/pricing"
>
  <section class="section">
    <h1>Not for sale</h1>
    <p class="lead">
      Orbit Yard is <strong>open source</strong> — CLI, TUI, and Desktop. There is no Solo plan,
      no Paddle checkout, and no license paywall. Download a release or clone the repo.
    </p>

    <aside class="soft-no" role="note">
      <p class="soft-no-kicker">Honest</p>
      <p class="soft-no-body">
        Commercial Solo was cancelled. This site does not sell the tool. Desktop Suite links
        (Strata / Velocity) are separate scaffolds — not required to Get live, and not a storefront
        for Orbit Yard.
      </p>
    </aside>

    <div class="price-block">
      <div class="price-row">
        <div>
          <strong>Free</strong>
          <p class="price-meta">MIT · one operator or a team · you own the machine</p>
        </div>
        <p class="price-amount">$0</p>
      </div>
      <ul class="list-clean">
        <li>orbityard CLI, TUI, and Desktop — Adaptive Publish spine</li>
        <li>Host deploy gates · env honesty · local vault export</li>
        <li>Docs on this site · dogfood scripts in the repo</li>
        <li>Packaged builds on <a href={downloadUrl()}>GitHub Releases</a></li>
        <li>Full source — clone, build, and run without buying anything</li>
      </ul>

      <h2 class="price-delta-title">What you get</h2>
      <div class="price-delta">
        <div>
          <p class="price-delta-label">Download</p>
          <ul class="list-clean">
            <li>Supported Desktop / CLI cuts for the current release tag</li>
            <li>Same honesty gates as building from source</li>
            <li>No timed trial · no account required to try</li>
          </ul>
        </div>
        <div>
          <p class="price-delta-label">Build from source</p>
          <ul class="list-clean">
            <li>Full source on GitHub — clone, build, run for free</li>
            <li>You own compile, signing, and updates</li>
            <li>Same sequencing product — no commercial support SKU</li>
          </ul>
        </div>
      </div>
      <p class="note">
        Studio never writes secrets, never auto-publishes to npm/crates/stores, and never replaces
        vendor UIs. There is nothing to “unlock” with a credit card.
      </p>
      <a class="btn btn-primary" href={downloadUrl()} rel="noopener noreferrer">Download</a>
      <p class="price-meta">
        <a href="https://github.com/Dendro-X0/ship-studio">GitHub</a>
        · <a href="/demo">Demo</a>
        · <a href="/faq">FAQ</a>
        · <a href="/legal/terms">Terms</a>
      </p>
    </div>
  </section>
</BaseLayout>
