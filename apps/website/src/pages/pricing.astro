---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CHECKOUT_SUCCESS_PATH,
  checkoutConfigured,
  downloadUrl,
  paddleClientToken,
  paddleEnv,
  paddlePriceId,
  priceLabel,
  refundWindowDays,
} from "../lib/commerce";

const ready = checkoutConfigured();
const token = paddleClientToken();
const priceId = paddlePriceId();
const env = paddleEnv();
---

<BaseLayout
  title="Pricing — Ship Studio"
  description={`Solo license via Paddle. ${refundWindowDays()}-day refunds.`}
  path="/pricing"
>
  <section class="section">
    <h1>Pricing</h1>
    <p class="lead">
      One Solo plan for the local hub (CLI · TUI · Desktop). Checkout is hosted by
      <strong>Paddle</strong> — we never see your card number.
    </p>

    <div class="price-block">
      <div class="price-row">
        <div>
          <strong>Solo</strong>
          <p class="price-meta">Perpetual license · one operator · updates on the current major</p>
        </div>
        <p class="price-amount">{priceLabel()}</p>
      </div>
      <ul class="list-clean">
        <li>shipctl CLI, TUI, and Desktop — Adaptive Publish spine</li>
        <li>Launch companion · provider portal · env honesty · local vault export</li>
        <li>Docs on this site · dogfood scripts in the repo</li>
        <li>Local <a href="/license">license key file</a> after checkout (email after Paddle confirms)</li>
        <li>{refundWindowDays()}-day refund window — see <a href="/legal/refunds">refunds</a></li>
      </ul>

      <h2 class="price-delta-title">What $29 buys vs building from source</h2>
      <div class="price-delta">
        <div>
          <p class="price-delta-label">Solo license</p>
          <ul class="list-clean">
            <li>Supported download builds + license file for this major</li>
            <li>Paddle-hosted checkout · invoices · refunds in the published window</li>
            <li>Packaged Desktop / CLI without assembling the toolchain yourself</li>
          </ul>
        </div>
        <div>
          <p class="price-delta-label">OSS / build-from-source</p>
          <ul class="list-clean">
            <li>Full source on GitHub — clone, build, run for free</li>
            <li>Same sequencing honesty; you own compile, signing, and updates</li>
            <li>No Solo license file · no commercial support path</li>
          </ul>
        </div>
      </div>
      <p class="note">
        Studio never writes secrets, never auto-publishes to npm/crates/stores, and never
        replaces vendor UIs. Paying is for the packaged Solo loop — not a paywall on the
        publish sequence itself.
      </p>
      {
        ready ? (
          <button
            type="button"
            class="btn btn-primary"
            id="paddle-checkout"
            data-paddle-token={token}
            data-paddle-price={priceId}
            data-paddle-env={env}
            data-paddle-success={CHECKOUT_SUCCESS_PATH}
          >
            Checkout with Paddle
          </button>
        ) : (
          <>
            <a class="btn btn-primary btn-disabled" href="#" aria-disabled="true">
              Checkout with Paddle
            </a>
            <p class="note">
              Set PUBLIC_PADDLE_CLIENT_TOKEN and PUBLIC_PADDLE_PRICE_ID — see
              apps/website/docs/PADDLE-SETUP.md. Use Paddle <strong>Sandbox</strong> until a test
              card works.
            </p>
          </>
        )
      }
      <p class="price-meta">
        Prefer trying first? <a href={downloadUrl()}>Download from GitHub Releases</a>
        · manage orders on <a href="/account">your account</a>
        · common questions on <a href="/faq">FAQ</a>
      </p>
    </div>
  </section>
  {
    ready && (
      <>
        <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
        <script is:inline>
          const boot = () => {
            const btn = document.getElementById("paddle-checkout");
            if (!btn || typeof Paddle === "undefined") return;
            const token = btn.getAttribute("data-paddle-token") || "";
            const priceId = btn.getAttribute("data-paddle-price") || "";
            const env = btn.getAttribute("data-paddle-env") || "sandbox";
            const successPath = btn.getAttribute("data-paddle-success") || "/checkout/success";
            if (!token || !priceId) return;
            if (env !== "live") {
              Paddle.Environment.set("sandbox");
            }
            Paddle.Initialize({ token });
            btn.addEventListener("click", (e) => {
              e.preventDefault();
              Paddle.Checkout.open({
                items: [{ priceId, quantity: 1 }],
                settings: {
                  successUrl: `${window.location.origin}${successPath}`,
                },
              });
            });
          };
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", boot);
          } else {
            boot();
          }
        </script>
      </>
    )
  }
</BaseLayout>
