---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  checkoutConfigured,
  downloadUrl,
  polarCheckoutUrl,
  polarPortalUrl,
  priceLabel,
  refundWindowDays,
} from "../lib/commerce";
---

<BaseLayout
  title="Pricing — Ship Studio"
  description={`Solo license via Polar. ${refundWindowDays()}-day refunds.`}
  path="/pricing"
>
  <section class="section">
    <h1>Pricing</h1>
    <p class="lead">
      One Solo plan for the local hub (CLI · TUI · Desktop). Checkout is hosted by
      <strong>Polar</strong> — we never see your card number.
    </p>

    <div class="price-block">
      <div class="price-row">
        <div>
          <strong>Solo</strong>
          <p class="price-meta">Perpetual license · one operator · updates on the current major</p>
        </div>
        <p class="price-amount">{priceLabel()}</p>
      </div>
      <ul class="list-clean">
        <li>shipctl CLI, TUI, and Desktop — Adaptive Publish spine</li>
        <li>Launch companion · provider portal · env honesty · local vault export</li>
        <li>Docs on this site · dogfood scripts in the repo</li>
        <li>Local <a href="/license">license key file</a> after checkout (email / Polar benefit)</li>
        <li>{refundWindowDays()}-day refund window — see <a href="/legal/refunds">refunds</a></li>
      </ul>

      <h2 class="price-delta-title">What $29 buys vs building from source</h2>
      <div class="price-delta">
        <div>
          <p class="price-delta-label">Solo license</p>
          <ul class="list-clean">
            <li>Supported download builds + license file for this major</li>
            <li>Polar-hosted checkout · invoices · refunds in the published window</li>
            <li>Packaged Desktop / CLI without assembling the toolchain yourself</li>
          </ul>
        </div>
        <div>
          <p class="price-delta-label">OSS / build-from-source</p>
          <ul class="list-clean">
            <li>Full source on GitHub — clone, build, run for free</li>
            <li>Same sequencing honesty; you own compile, signing, and updates</li>
            <li>No Solo license file · no commercial support path</li>
          </ul>
        </div>
      </div>
      <p class="note">
        Studio never writes secrets, never auto-publishes to npm/crates/stores, and never
        replaces vendor UIs. Paying is for the packaged Solo loop — not a paywall on the
        publish sequence itself.
      </p>
      {
        checkoutConfigured() ? (
          <a
            class="btn btn-primary"
            href={polarCheckoutUrl()}
            rel="noopener noreferrer"
            target="_blank"
          >
            Checkout with Polar
          </a>
        ) : (
          <>
            <a class="btn btn-primary btn-disabled" href="#" aria-disabled="true">
              Checkout with Polar
            </a>
            <p class="note">
              Set PUBLIC_POLAR_CHECKOUT_URL — see apps/website/docs/POLAR-SETUP.md
            </p>
          </>
        )
      }
      <p class="price-meta">
        Prefer trying first? <a href={downloadUrl()}>Download from GitHub Releases</a>
        · manage orders on <a href="/account">your account</a>
        ({" "}
        <a href={polarPortalUrl()} rel="noopener noreferrer">Polar portal</a>)
      </p>
    </div>
  </section>
</BaseLayout>
