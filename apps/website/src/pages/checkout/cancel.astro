---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { downloadUrl } from "../../lib/commerce";
---

<BaseLayout
  title="Checkout closed — Orbit Yard"
  description="Orbit Yard is not sold. Download free from GitHub Releases."
  path="/checkout/cancel"
>
  <section class="section">
    <h1>Checkout closed</h1>
    <p class="lead">
      There is no active paid checkout. Download a free build from GitHub Releases.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={downloadUrl()} rel="noopener noreferrer">Download</a>
      <a class="btn" href="/pricing">Get it free</a>
      <a class="btn" href="/">Home</a>
    </div>
  </section>
</BaseLayout>
