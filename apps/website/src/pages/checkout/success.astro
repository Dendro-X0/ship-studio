---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { downloadUrl } from "../../lib/commerce";
---

<BaseLayout
  title="Checkout closed — Orbit Yard"
  description="Orbit Yard is not sold. Download free from GitHub Releases."
  path="/checkout/success"
>
  <section class="section">
    <h1>Checkout closed</h1>
    <p class="lead">
      Orbit Yard is no longer sold. If you landed here from an old link, there is nothing to buy —
      download the OSS build instead.
    </p>
    <div class="hero-cta" style="margin-top: 1.5rem">
      <a class="btn btn-primary" href={downloadUrl()} rel="noopener noreferrer">Download</a>
      <a class="btn" href="/pricing">Get it free</a>
      <a class="btn" href="/docs/start">Start here</a>
    </div>
  </section>
</BaseLayout>
