{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ship Studio",
  "version": "0.2.0",
  "identifier": "com.dendro.shipstudio",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ship Studio",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0e1210"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
